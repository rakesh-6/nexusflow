// Database schema for NexusFlow, following PRD.md §17.
// Run `pnpm db:migrate` after changing this file to create a migration.
//
// Conventions:
// - ids are UUID v7, generated by Prisma in the app (PRD A-14)
// - every timestamp is stored with its time zone (timestamptz)
// - tenant tables carry `organizationId` so every query can be scoped (PRD §20)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  // citext: case-insensitive text for emails. pg_trgm: fuzzy search (used in step 5c).
  extensions = [citext, pg_trgm]
}

// ============================================================================
// Enums (PRD §17.2)
// ============================================================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceRole {
  WORKSPACE_ADMIN
  WORKSPACE_MEMBER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMMENTED
  MENTIONED
  PROJECT_ADDED
  PROJECT_STATUS_CHANGED
  MILESTONE_DUE_SOON
  ORG_INVITATION
  MEMBER_JOINED
  AUTOMATION_ALERT
  BILLING_EVENT
}

// A person's role inside one project (PRD §12.1).
enum ProjectRole {
  PROJECT_MANAGER
  CONTRIBUTOR
  VIEWER
}

// Project lifecycle (PRD §11.5.2).
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

// WORKSPACE: every workspace member can view it. PRIVATE: only project members.
enum ProjectVisibility {
  WORKSPACE
  PRIVATE
}

// Used by both projects and tasks.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Projects may rename their columns freely, but every column belongs to one of
// these six fixed categories, so analytics and automations always work (PRD §11.6.2).
enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum MilestoneStatus {
  OPEN
  COMPLETED
}

// PENDING until the server confirms the Cloudinary upload (PRD §11.11.1).
enum AttachmentStatus {
  PENDING
  READY
  DELETED
}

// Cloudinary's three storage kinds: images, videos, and everything else ("raw").
enum ResourceType {
  IMAGE
  VIDEO
  RAW
}

// DOMAIN: normal work history. SECURITY and BILLING rows form the audit log (PRD §11.17).
enum ActivityCategory {
  DOMAIN
  SECURITY
  BILLING
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

// Mirrors the Razorpay subscription lifecycle (PRD §23.3).
enum SubscriptionStatus {
  ACTIVE
  AUTHENTICATED
  INCOMPLETE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  PAID
  PARTIALLY_PAID
  EXPIRED
  CANCELLED
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AiFeature {
  TASK_DESCRIPTION
  TASK_BREAKDOWN
  PROJECT_PLAN
  PROJECT_SUMMARY
  MEETING_NOTES
  INSIGHTS
  DEADLINE_SUGGESTION
  WEEKLY_REPORT
}

// ============================================================================
// Identity (PRD §17.3): users, sign-in methods, sessions, one-time tokens
// ============================================================================

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique @db.Citext
  // Null for users who only sign in with Google.
  passwordHash          String?
  name                  String    @db.VarChar(80)
  avatarUrl             String?
  avatarPublicId        String?
  timezone              String    @default("UTC") @db.VarChar(64)
  emailVerifiedAt       DateTime? @db.Timestamptz(3)
  isPlatformAdmin       Boolean   @default(false)
  lastActiveWorkspaceId String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  // Account deletion is a soft delete that also scrubs personal data (PRD §11.1.7).
  deletedAt             DateTime? @db.Timestamptz(3)

  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  notificationPreferences NotificationPreference[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  workspaceMemberships    WorkspaceMember[]
  teamMemberships         TeamMember[]
  sentInvitations         Invitation[]             @relation("InvitationSender")
  ownedProjects           Project[]                @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  reportedTasks           Task[]                   @relation("TaskReporter")
  taskAssignments         TaskAssignee[]
  comments                Comment[]                @relation("CommentAuthor")
  commentReactions        CommentReaction[]
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")
  notifications           Notification[]
}

// A linked Google account (PRD §19.4).
model OAuthAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(20)
  providerAccountId String   @db.VarChar(255)
  email             String?  @db.Citext
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash
// is stored here, so a database leak does not reveal usable tokens (PRD §19.1).
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  userAgent         String?
  ip                String?   @db.VarChar(45)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  // Set when the user re-enters their password before a sensitive action.
  reauthAt          DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use email verification and password reset tokens (stored hashed).
model VerificationToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      VerificationType
  tokenHash String           @unique @db.Char(64)
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Per-user choice of in-app and email delivery for each notification type.
model NotificationPreference {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(true)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ============================================================================
// Tenant core (PRD §17.3): organizations, workspaces, teams, invitations
// ============================================================================

// The tenant and billing account. Everything a customer owns hangs off this.
model Organization {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String    @db.VarChar(60)
  slug             String    @unique @db.VarChar(40)
  // Old slugs keep redirecting for 30 days after a rename (PRD §11.2.2).
  slugHistory      String[]  @default([])
  logoUrl          String?
  logoPublicId     String?
  ownerId          String    @db.Uuid
  // Permission toggles, aiEnabled, report time zone (PRD §11.2.2).
  settings         Json      @default("{}")
  storageUsedBytes BigInt    @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)
  // Deleted organizations are purged by a background job after this time.
  purgeAfter       DateTime? @db.Timestamptz(3)

  owner            User                  @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          OrganizationMember[]
  workspaces       Workspace[]
  workspaceMembers WorkspaceMember[]
  teams            Team[]
  teamMembers      TeamMember[]
  invitations      Invitation[]
  projects         Project[]
  projectMembers   ProjectMember[]
  taskStatuses     TaskStatus[]
  labels           Label[]
  milestones       Milestone[]
  tasks            Task[]
  taskAssignees    TaskAssignee[]
  taskDependencies TaskDependency[]
  taskTemplates    TaskTemplate[]
  comments         Comment[]
  attachments      Attachment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  subscription     Subscription?
  billingProfile   BillingProfile?
  payments         Payment[]
  invoices         Invoice[]
  automations      Automation[]
  automationRuns   AutomationExecution[]
  aiUsages         AiUsage[]
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  invitedById    String?      @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  // The database itself guarantees at most one OWNER per organization.
  @@unique([organizationId], map: "OrganizationMember_one_owner_per_org", where: raw("role = 'OWNER'"))
  @@index([userId])
  @@index([organizationId, role])
}

model Workspace {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(60)
  slug           String    @db.VarChar(40)
  description    String?
  logoUrl        String?
  logoPublicId   String?
  accentColor    String?   @db.Char(7)
  // The "General" workspace created with every organization (PRD §11.2.1).
  isDefault      Boolean   @default(false)
  settings       Json      @default("{}")
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  teams         Team[]
  invitations   Invitation[]
  projects      Project[]
  labels        Label[]
  taskTemplates TaskTemplate[]
  automations   Automation[]

  @@unique([organizationId, slug])
  // At most one default workspace per organization.
  @@unique([organizationId], map: "Workspace_one_default_per_org", where: { isDefault: true })
}

model WorkspaceMember {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  userId         String        @db.Uuid
  role           WorkspaceRole @default(WORKSPACE_MEMBER)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([organizationId, userId])
}

model Team {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @db.Uuid
  workspaceId    String                   @db.Uuid
  name           String                   @db.VarChar(60)
  slug           String                   @db.VarChar(40)
  description    String?
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?                @db.Timestamptz(3)
  // Search index text, filled automatically by PostgreSQL from name and
  // description (a generated column, see the step 5c migration). Never written by the app.
  searchVector   Unsupported("tsvector")? @default(dbgenerated())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@index([searchVector], type: Gin)
}

model TeamMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  role           TeamRole @default(MEMBER)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// An emailed invitation to join an organization (PRD §11.3).
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @db.Uuid
  workspaceId      String?          @db.Uuid
  email            String           @db.Citext
  // Never OWNER; ownership only changes through a transfer (PRD §12.1).
  role             OrgRole
  // Projects a GUEST will be added to on acceptance.
  projectIds       String[]         @default([]) @db.Uuid
  tokenHash        String           @unique @db.Char(64)
  status           InvitationStatus @default(PENDING)
  invitedById      String           @db.Uuid
  expiresAt        DateTime         @db.Timestamptz(3)
  acceptedAt       DateTime?        @db.Timestamptz(3)
  acceptedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  // Only one pending invitation per email per organization.
  @@unique([organizationId, email], map: "Invitation_one_pending_per_email", where: raw("status = 'PENDING'"))
  @@index([organizationId, status])
  @@index([email])
}

// ============================================================================
// Projects and tasks (PRD §17.3)
// ============================================================================

model Project {
  id              String                   @id @default(uuid(7)) @db.Uuid
  organizationId  String                   @db.Uuid
  workspaceId     String                   @db.Uuid
  // Optional: a project can belong to a team or directly to the workspace.
  teamId          String?                  @db.Uuid
  // Short code used in task ids, e.g. "NEX" in "NEX-42". Locked after the first task.
  key             String                   @db.VarChar(6)
  name            String                   @db.VarChar(100)
  // Rich text from the editor (Tiptap JSON), plus a plain-text copy for search.
  description     Json?
  descriptionText String?
  coverImageUrl   String?
  coverPublicId   String?
  status          ProjectStatus            @default(PLANNING)
  // Remembered when archiving, so "restore" can return to it.
  previousStatus  ProjectStatus?
  priority        Priority                 @default(MEDIUM)
  visibility      ProjectVisibility        @default(WORKSPACE)
  ownerId         String                   @db.Uuid
  // Calendar dates without a time of day (PRD A-19).
  startDate       DateTime?                @db.Date
  endDate         DateTime?                @db.Date
  // Last task number handed out; increased by 1 for every new task.
  taskSequence    Int                      @default(0)
  // Set when a downgrade leaves the org over its plan limit (PRD §11.14.5).
  isReadOnly      Boolean                  @default(false)
  completedAt     DateTime?                @db.Timestamptz(3)
  archivedAt      DateTime?                @db.Timestamptz(3)
  createdById     String                   @db.Uuid
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  // Soft delete: hidden at once, permanently removed after 30 days (PRD §11.5.6).
  deletedAt       DateTime?                @db.Timestamptz(3)
  // Generated by PostgreSQL from name, key and description (see the step 5c migration).
  searchVector    Unsupported("tsvector")? @default(dbgenerated())

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team          Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       ProjectMember[]
  statuses      TaskStatus[]
  milestones    Milestone[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  discussions   Comment[]
  attachments   Attachment[]
  automations   Automation[]

  @@unique([workspaceId, key])
  @@index([organizationId, status])
  @@index([workspaceId, status, deletedAt])
  @@index([teamId])
  @@index([searchVector], type: Gin)
  // Trigram index: finds names even with typos or partial words (PRD §11.13).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Project_name_trgm_idx", type: Gin)
}

// Who belongs to a project and with which role.
model ProjectMember {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  projectId      String      @db.Uuid
  userId         String      @db.Uuid
  role           ProjectRole
  addedById      String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, organizationId])
}

// One Kanban column, e.g. "In Review". Each project gets six by default.
model TaskStatus {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  projectId      String         @db.Uuid
  name           String         @db.VarChar(40)
  // Hex color such as "#4F46E5".
  color          String         @db.Char(7)
  category       StatusCategory
  // Column order on the board, left to right.
  position       Int
  // The status new tasks start in.
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([projectId, name])
  // At most one default status per project.
  @@unique([projectId], map: "TaskStatus_one_default_per_project", where: { isDefault: true })
  @@index([projectId, position])
}

// A colored tag shared by all projects in a workspace, e.g. "Bug".
model Label {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  name           String   @db.VarChar(40)
  color          String   @db.Char(7)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        TaskLabel[]

  @@unique([workspaceId, name])
}

// A checkpoint in a project, e.g. "Beta launch", that tasks can be linked to.
model Milestone {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  projectId      String          @db.Uuid
  name           String          @db.VarChar(100)
  description    String?
  dueDate        DateTime?       @db.Date
  status         MilestoneStatus @default(OPEN)
  position       Int
  completedAt    DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([projectId, position])
  @@index([projectId, dueDate])
}

model Task {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  organizationId     String                   @db.Uuid
  projectId          String                   @db.Uuid
  // The "42" in "NEX-42". Unique inside its project.
  number             Int
  title              String                   @db.VarChar(200)
  description        Json?
  descriptionText    String?
  statusId           String                   @db.Uuid
  priority           Priority                 @default(MEDIUM)
  reporterId         String                   @db.Uuid
  // Set for subtasks: points at the parent task (one level deep).
  parentTaskId       String?                  @db.Uuid
  milestoneId        String?                  @db.Uuid
  startDate          DateTime?                @db.Date
  dueDate            DateTime?                @db.Date
  // Up to 99,999.99 hours with two decimals.
  estimatedHours     Decimal?                 @db.Decimal(7, 2)
  actualHours        Decimal?                 @db.Decimal(7, 2)
  // Order inside a Kanban column, as a sortable string such as "a0" (fractional indexing).
  position           String                   @db.VarChar(64)
  // Increases on every update, so two people editing at once cannot overwrite each other.
  version            Int                      @default(1)
  completedAt        DateTime?                @db.Timestamptz(3)
  // Remember which reminders were already sent, so each is sent once.
  dueSoonNotifiedAt  DateTime?                @db.Timestamptz(3)
  overdueNotifiedAt  DateTime?                @db.Timestamptz(3)
  // Recurring tasks and templates (Post-MVP, Phase 5b).
  recurrenceRule     String?
  recurrenceParentId String?                  @db.Uuid
  templateId         String?                  @db.Uuid
  createdById        String                   @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?                @db.Timestamptz(3)
  // Generated by PostgreSQL from title and description (see the step 5c migration).
  searchVector       Unsupported("tsvector")? @default(dbgenerated())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // NoAction (checked at the end of the statement) instead of Restrict: a status
  // with tasks still cannot be deleted on its own, but deleting a whole project
  // can remove its tasks and statuses together.
  status       TaskStatus   @relation(fields: [statusId], references: [id], onDelete: NoAction)
  reporter     User         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("Subtasks")
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assignees   TaskAssignee[]
  labels      TaskLabel[]
  blocks      TaskDependency[] @relation("BlockingTask")
  blockedBy   TaskDependency[] @relation("BlockedTask")
  comments    Comment[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@index([projectId, statusId, position])
  @@index([projectId, deletedAt])
  @@index([organizationId, dueDate])
  @@index([organizationId, completedAt])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([reporterId])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "Task_title_trgm_idx", type: Gin)
}

// A task can have several assignees (PRD A-15).
model TaskAssignee {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  taskId         String   @db.Uuid
  userId         String   @db.Uuid
  assignedById   String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, organizationId])
}

// Which labels are on which task. The pair (task, label) is the primary key.
model TaskLabel {
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// "Blocking task must finish before blocked task can start". Cycles are rejected in code.
model TaskDependency {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  blockingTaskId String   @db.Uuid
  blockedTaskId  String   @db.Uuid
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockingTask Task         @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task         @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([blockedTaskId])
}

// A reusable task blueprint with title, description, labels and subtasks (Post-MVP).
model TaskTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  // Empty: available in the whole workspace. Set: only in this project.
  projectId      String?  @db.Uuid
  name           String   @db.VarChar(100)
  data           Json
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// ============================================================================
// Collaboration (PRD §17.3): comments, reactions, files, notifications, history
// ============================================================================

// A comment on a task, or (Post-MVP) a project discussion. Exactly one of
// taskId / projectId is set; a check constraint in the migration enforces it.
model Comment {
  id              String                   @id @default(uuid(7)) @db.Uuid
  organizationId  String                   @db.Uuid
  taskId          String?                  @db.Uuid
  projectId       String?                  @db.Uuid
  // Set for replies. Replies cannot have replies (one level, checked in code).
  parentCommentId String?                  @db.Uuid
  authorId        String                   @db.Uuid
  // Rich text (Tiptap JSON) and a plain-text copy for search and emails.
  body            Json
  bodyText        String
  editedAt        DateTime?                @db.Timestamptz(3)
  deletedAt       DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  // Generated by PostgreSQL from bodyText (see the step 5c migration).
  searchVector    Unsupported("tsvector")? @default(dbgenerated())

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task          Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentComment Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("CommentReplies")
  author        User              @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reactions     CommentReaction[]
  attachments   Attachment[]

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([parentCommentId])
  @@index([searchVector], type: Gin)
}

// One emoji from one user on one comment. Clicking again removes it.
model CommentReaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

// A file stored in Cloudinary. Only its details live here (PRD §11.11).
model Attachment {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  taskId            String?          @db.Uuid
  commentId         String?          @db.Uuid
  projectId         String?          @db.Uuid
  uploaderId        String           @db.Uuid
  // "attachment" (on a task/comment/project), "avatar", "cover" or "logo".
  purpose           String           @default("attachment") @db.VarChar(16)
  originalName      String           @db.VarChar(255)
  mimeType          String           @db.VarChar(127)
  bytes             BigInt
  resourceType      ResourceType
  // Cloudinary's id for the file; also its storage path.
  publicId          String           @unique
  format            String?          @db.VarChar(16)
  width             Int?
  height            Int?
  cloudinaryVersion String?          @db.VarChar(32)
  status            AttachmentStatus @default(PENDING)
  readyAt           DateTime?        @db.Timestamptz(3)
  deletedAt         DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User         @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([commentId])
  @@index([organizationId, status, createdAt])
}

// One item in a user's Inbox.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  // Empty only for notifications not tied to an organization.
  organizationId String?          @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  body           String?
  // Where clicking the notification leads: org, workspace, project and task keys.
  data           Json             @default("{}")
  // Empty means unread.
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// Append-only history of everything that happened. Rows are never updated.
// The audit log is the SECURITY and BILLING rows (PRD §11.17).
model ActivityLog {
  id             String           @id @default(uuid(7)) @db.Uuid
  // Empty only for sign-in events of users who have no organization yet (PRD A-23).
  organizationId String?          @db.Uuid
  // Plain ids without links, so history survives when the thing is deleted.
  workspaceId    String?          @db.Uuid
  projectId      String?          @db.Uuid
  taskId         String?          @db.Uuid
  // Empty means the system or an automation did it.
  actorId        String?          @db.Uuid
  category       ActivityCategory
  // What happened, e.g. "task.updated" or "member.role_changed".
  action         String           @db.VarChar(64)
  entityType     String           @db.VarChar(32)
  entityId       String           @db.Uuid
  // Field-by-field changes: [{ field, from, to }].
  changes        Json?
  metadata       Json?
  ip             String?          @db.VarChar(45)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([organizationId, category, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

// ============================================================================
// Billing (PRD §17.3, §23): Razorpay test mode only
// ============================================================================

// Every organization has exactly one subscription row, FREE by default.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  organizationId         String             @unique @db.Uuid
  planTier               PlanTier           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  interval               BillingInterval?
  provider               String?            @db.VarChar(20)
  providerCustomerId     String?            @db.VarChar(64)
  providerSubscriptionId String?            @unique @db.VarChar(64)
  providerPlanId         String?            @db.VarChar(64)
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  // A downgrade waits here until the current billing period ends.
  scheduledPlanTier      PlanTier?
  scheduledInterval      BillingInterval?
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  metadata               Json               @default("{}")
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]
  invoices     Invoice[]
}

// Who invoices are addressed to.
model BillingProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @unique @db.Uuid
  legalName      String   @db.VarChar(120)
  email          String   @db.Citext
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String   @default("IN") @db.Char(2)
  gstin          String?  @db.VarChar(15)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  invoiceId         String?       @db.Uuid
  provider          String        @db.VarChar(20)
  providerPaymentId String        @unique @db.VarChar(64)
  // Money is stored in the smallest unit (paise) as a whole number, never as a decimal.
  amount            Int
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus
  method            String?       @db.VarChar(32)
  failureReason     String?
  paidAt            DateTime?     @db.Timestamptz(3)
  rawPayload        Json?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
}

model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  provider          String        @db.VarChar(20)
  providerInvoiceId String        @unique @db.VarChar(64)
  number            String?       @db.VarChar(64)
  amountDue         Int
  amountPaid        Int
  currency          String        @default("INR") @db.Char(3)
  status            InvoiceStatus
  periodStart       DateTime?     @db.Timestamptz(3)
  periodEnd         DateTime?     @db.Timestamptz(3)
  issuedAt          DateTime?     @db.Timestamptz(3)
  paidAt            DateTime?     @db.Timestamptz(3)
  hostedUrl         String?
  pdfUrl            String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, issuedAt(sort: Desc)])
}

// Every Razorpay webhook received, stored once. The unique rule makes repeated
// deliveries of the same event harmless (PRD §11.14.4).
model WebhookEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String    @db.VarChar(20)
  providerEventId String    @db.VarChar(128)
  type            String    @db.VarChar(64)
  payload         Json
  receivedAt      DateTime  @default(now()) @db.Timestamptz(3)
  processedAt     DateTime? @db.Timestamptz(3)
  error           String?
  attempts        Int       @default(0)

  @@unique([provider, providerEventId])
  // Fast lookup of events still waiting to be processed.
  @@index([receivedAt], map: "WebhookEvent_unprocessed_idx", where: { processedAt: null })
}

// "Contact us" requests from the Enterprise pricing column (Post-MVP).
model SalesLead {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @db.Citext
  name      String   @db.VarChar(100)
  company   String   @db.VarChar(120)
  message   String
  source    String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

// ============================================================================
// Automation and AI (PRD §17.3; Post-MVP Phases 10 and 11)
// ============================================================================

// A "when X happens, if Y, then do Z" rule (PRD §11.15). The JSON shapes are
// checked by Zod schemas in packages/shared.
model Automation {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @db.Uuid
  workspaceId         String    @db.Uuid
  // Empty: applies to every project in the workspace.
  projectId           String?   @db.Uuid
  name                String    @db.VarChar(100)
  description         String?
  isEnabled           Boolean   @default(true)
  trigger             Json
  conditions          Json      @default("[]")
  actions             Json
  createdById         String    @db.Uuid
  lastRunAt           DateTime? @db.Timestamptz(3)
  runCount            Int       @default(0)
  // Rules that keep failing are switched off automatically.
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId, isEnabled])
  @@index([workspaceId])
  @@index([projectId])
}

// One run of an automation and its outcome.
model AutomationExecution {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  automationId   String          @db.Uuid
  triggerEvent   Json
  status         ExecutionStatus
  result         Json?
  error          String?
  startedAt      DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?       @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt(sort: Desc)])
  @@index([organizationId, startedAt(sort: Desc)])
}

// One AI request, for quotas and cost tracking (PRD §24).
model AiUsage {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String?   @db.Uuid
  feature          AiFeature
  provider         String    @db.VarChar(20)
  model            String    @db.VarChar(64)
  promptTokens     Int
  completionTokens Int
  latencyMs        Int
  status           String    @db.VarChar(16)
  error            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
}
