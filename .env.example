# Copy this file to .env and fill in real values. Never commit .env.
# Real values go ONLY in .env (never here: this file is uploaded to GitHub).
# Every variable is documented in PRD.md Appendix D.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# The web app's address, used in links inside emails (verify email, reset password).
APP_URL=http://localhost:5173
# Websites allowed to call the API (comma-separated). 5173 is the Vite dev server.
WEB_ORIGINS=http://localhost:5173

# Requests allowed per minute per visitor. Health checks are never limited.
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# Background jobs (reminders, notification emails, clean-ups). They check the
# database every 30-60 seconds, which keeps the free Neon database awake while
# the API runs. Set to false when you do not need reminders locally.
JOBS_ENABLED=true

# --- Database (Neon free tier) ---
# In the Neon console, open your project, click "Connect", and pick the branch.
# DATABASE_URL: the "dev" branch with connection pooling ON (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# DIRECT_DATABASE_URL: the same "dev" branch with connection pooling OFF. Used by migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# TEST_DATABASE_URL: the "test" branch with connection pooling OFF. Used by automated tests,
# which empty and refill it. Never point it at the dev database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-test.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# --- Email ---
# "console" prints emails in the terminal (development), "memory" keeps them for
# automated tests, "brevo" really sends them (free plan, 300 a day).
MAIL_PROVIDER=console
MAIL_FROM=NexusFlow <no-reply@nexusflow.local>
# For MAIL_PROVIDER=brevo: Brevo > SMTP & API > API keys. MAIL_FROM must then be a
# sender address you verified in Brevo, e.g. NexusFlow <your-name@gmail.com>.
BREVO_API_KEY=
MAIL_DAILY_CAP=300

# --- Profile photos (Cloudinary free plan) --- optional; upload stays hidden while empty.
# Cloudinary console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=nexusflow/development

# --- "Continue with Google" --- optional; the button stays hidden while empty.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Razorpay TEST MODE, free) --- optional; upgrading stays off while empty.
# Razorpay dashboard (Test Mode on) > Account & Settings > API Keys > Generate Test Key.
# Put the REAL values only in .env, never here: this file is uploaded to GitHub.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Account & Settings > Webhooks: any password you choose, typed there too.
RAZORPAY_WEBHOOK_SECRET=
# Razorpay dashboard > Subscriptions > Plans: one plan id (starts with plan_) per price.
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=