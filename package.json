{
  "name": "nexusflow",
  "version": "0.1.0",
  "private": true,
  "description": "NexusFlow: multi-tenant project management and team collaboration platform",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nexusflow/api db:generate",
    "db:migrate": "pnpm --filter @nexusflow/api db:migrate",
    "db:studio": "pnpm --filter @nexusflow/api db:studio",
    "db:seed": "pnpm --filter @nexusflow/api db:seed",
    "test:e2e": "pnpm --filter @nexusflow/e2e test:e2e"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
