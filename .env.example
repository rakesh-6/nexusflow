# Copy this file to .env and fill in real values. Never commit .env.
# Every variable is documented in PRD.md Appendix D. More are added in later steps.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Websites allowed to call the API (comma-separated). 5173 is the Vite dev server.
WEB_ORIGINS=http://localhost:5173

# Requests allowed per minute per visitor. Health checks are never limited.
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# Email: "console" prints emails in the terminal (development), "memory" keeps
# them for automated tests. Real sending through Brevo is added in Phase 2.
MAIL_PROVIDER=console
MAIL_FROM=NexusFlow <no-reply@nexusflow.local>

# --- Database (Neon free tier) ---
# In the Neon console, open your project, click "Connect", and pick the branch.
# Real values go ONLY in .env (never here: this file is uploaded to GitHub).
# DATABASE_URL: the "dev" branch with connection pooling ON (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL: the same "dev" branch with connection pooling OFF. Used by migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# TEST_DATABASE_URL: the "test" branch with connection pooling OFF. Used by automated tests,
# which empty and refill it. Never point it at the dev database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-test.us-east-2.aws.neon.tech/neondb?sslmode=require